///|
// Expected text captured from the pinned pre-migration implementation.
test "public display formats remain compatible" {
  let value = @clap.SimpleValue::new("a\"b\nc")
  value.args["first"] = ["one", "two"]
  value.flags["verbose"] = true
  value.positional_args.push("three")
  value.subcmd = Some(@clap.SimpleValue::new("child"))
  assert_eq(Show::to_string(@assets.AssetCopyError::SourceReadError("a\"b\nc", "a\"b\nc")), "SourceReadError(a\"b\nc, a\"b\nc)")
  assert_eq(Show::to_string(@assets.AssetCopyError::SourceNotDirectory("a\"b\nc")), "SourceNotDirectory(a\"b\nc)")
  assert_eq(Show::to_string(@assets.AssetCopyError::DestCreateError("a\"b\nc", "a\"b\nc")), "DestCreateError(a\"b\nc, a\"b\nc)")
  assert_eq(Show::to_string(@assets.AssetCopyError::FileReadError("a\"b\nc", "a\"b\nc")), "FileReadError(a\"b\nc, a\"b\nc)")
  assert_eq(Show::to_string(@assets.AssetCopyError::FileWriteError("a\"b\nc", "a\"b\nc")), "FileWriteError(a\"b\nc, a\"b\nc)")
  assert_eq(Show::to_string(@data.DataError::FileNotFound("a\"b\nc")), "FileNotFound(a\"b\nc)")
  assert_eq(Show::to_string(@data.DataError::ParseError("a\"b\nc", 7, "a\"b\nc")), "ParseError(a\"b\nc, 7, a\"b\nc)")
  assert_eq(Show::to_string(@data.DataError::ValidationError("a\"b\nc", "a\"b\nc", "a\"b\nc")), "ValidationError(a\"b\nc, a\"b\nc, a\"b\nc)")
  assert_eq(Show::to_string(@data.DataError::IOError("a\"b\nc", "a\"b\nc")), "IOError(a\"b\nc, a\"b\nc)")
  assert_eq(Show::to_string(@diagnostic.Severity::Error), "Error")
  assert_eq(Show::to_string(@diagnostic.Severity::Warning), "Warning")
  assert_eq(Show::to_string(@highlight.TokenKind::Keyword), "Keyword")
  assert_eq(Show::to_string(@highlight.TokenKind::Type), "Type")
  assert_eq(Show::to_string(@highlight.TokenKind::StringLit), "StringLit")
  assert_eq(Show::to_string(@highlight.TokenKind::CharLit), "CharLit")
  assert_eq(Show::to_string(@highlight.TokenKind::Number), "Number")
  assert_eq(Show::to_string(@highlight.TokenKind::Comment), "Comment")
  assert_eq(Show::to_string(@highlight.TokenKind::Operator), "Operator")
  assert_eq(Show::to_string(@highlight.TokenKind::Punct), "Punct")
  assert_eq(Show::to_string(@highlight.TokenKind::Identifier), "Identifier")
  assert_eq(Show::to_string(@highlight.TokenKind::Builtin), "Builtin")
  assert_eq(Show::to_string(@highlight.TokenKind::Whitespace), "Whitespace")
  assert_eq(Show::to_string(@highlight.TokenKind::Unknown), "Unknown")
  assert_eq(Show::to_string(@lint.ViolationType::SchemaError), "SchemaError")
  assert_eq(Show::to_string(@lint.ViolationType::MissingRequiredFrontmatter), "MissingRequiredFrontmatter")
  assert_eq(Show::to_string(@lint.ViolationType::BrokenWikilink), "BrokenWikilink")
  assert_eq(Show::to_string(@lint.ViolationType::DanglingTagReference), "DanglingTagReference")
  assert_eq(Show::to_string(@lint.ViolationType::TemplateSlotError), "TemplateSlotError")
  assert_eq(Show::to_string(@lint.ViolationType::DataError), "DataError")
  assert_eq(Show::to_string(@lint.ViolationType::ShortcodeError), "ShortcodeError")
  assert_eq(Show::to_string(@lint.ViolationType::FrontmatterError), "FrontmatterError")
  assert_eq(Show::to_string(@lint.ViolationType::CollectionsError), "CollectionsError")
  assert_eq(Show::to_string(@lint.ViolationType::DuplicateSlug), "DuplicateSlug")
  assert_eq(Show::to_string(@lint.ViolationType::IOError), "IOError")
  assert_eq(Show::to_string(@shortcode.ShortcodeError::UnknownShortcode("a\"b\nc")), "UnknownShortcode(a\"b\nc)")
  assert_eq(Show::to_string(@shortcode.ShortcodeError::MissingParam("a\"b\nc", "a\"b\nc")), "MissingParam(a\"b\nc, a\"b\nc)")
  assert_eq(Show::to_string(@shortcode.ShortcodeError::InvalidParamType("a\"b\nc", "a\"b\nc", "a\"b\nc")), "InvalidParamType(a\"b\nc, a\"b\nc, a\"b\nc)")
  assert_eq(Show::to_string(@shortcode.ShortcodeError::InvalidSyntax("a\"b\nc")), "InvalidSyntax(a\"b\nc)")
  assert_eq(Show::to_string(@template.TemplateSlot::Title), "Title")
  assert_eq(Show::to_string(@template.TemplateSlot::Content), "Content")
  assert_eq(Show::to_string(@template.TemplateSlot::Date), "Date")
  assert_eq(Show::to_string(@template.TemplateSlot::Description), "Description")
  assert_eq(Show::to_string(@template.TemplateSlot::Url), "Url")
  assert_eq(Show::to_string(@template.TemplateSlot::SiteName), "SiteName")
  assert_eq(Show::to_string(@template.TemplateSlot::NavLinks), "NavLinks")
  assert_eq(Show::to_string(@template.TemplateSlot::CustomCss), "CustomCss")
  assert_eq(Show::to_string(@template.TemplateSlot::TagName), "TagName")
  assert_eq(Show::to_string(@template.TemplateSlot::TagCount), "TagCount")
  assert_eq(Show::to_string(@template.TemplateSlot::Backlinks), "Backlinks")
  assert_eq(Show::to_string(@template.TemplateSlot::Tags), "Tags")
  assert_eq(Show::to_string(@template.TemplateSlot::Collection), "Collection")
  assert_eq(Show::to_string(@template.TemplateSlot::Year), "Year")
  assert_eq(Show::to_string(@template.TemplateSlot::Month), "Month")
  assert_eq(Show::to_string(@template.TemplateSlot::Day), "Day")
  assert_eq(Show::to_string(@template.TemplateSlot::PrevPostUrl), "PrevPostUrl")
  assert_eq(Show::to_string(@template.TemplateSlot::PrevPostTitle), "PrevPostTitle")
  assert_eq(Show::to_string(@template.TemplateSlot::NextPostUrl), "NextPostUrl")
  assert_eq(Show::to_string(@template.TemplateSlot::NextPostTitle), "NextPostTitle")
  assert_eq(Show::to_string(@template.TemplateSlot::NextPage), "NextPage")
  assert_eq(Show::to_string(@template.TemplateSlot::PrevPage), "PrevPage")
  assert_eq(Show::to_string(@template.TemplateSlot::PageNum), "PageNum")
  assert_eq(Show::to_string(@template.TemplateSlot::IsFirstPage), "IsFirstPage")
  assert_eq(Show::to_string(@template.TemplateSlot::IsLastPage), "IsLastPage")
  assert_eq(Show::to_string(@template.TemplateSlot::TotalPages), "TotalPages")
  assert_eq(Show::to_string(@template.TemplateSlot::PageUrl), "PageUrl")
  assert_eq(Show::to_string(@template.TemplateSlot::Body), "Body")
  assert_eq(Show::to_string(@template.TemplateSlot::BodyNoH1), "BodyNoH1")
  assert_eq(Show::to_string(@template.TemplateSlot::HeadMeta), "HeadMeta")
  assert_eq(Show::to_string(@template.TemplateSlot::ReadingTime), "ReadingTime")
  assert_eq(Show::to_string(@template.TemplateSlot::WordCount), "WordCount")
  assert_eq(Show::to_string(@template.TemplateSlot::TableOfContents), "TableOfContents")
  assert_eq(Show::to_string(@template.TemplateSlot::Author), "Author")
  assert_eq(Show::to_string(@template.TemplateSlot::Excerpt), "Excerpt")
  assert_eq(Show::to_string(@clap.Nargs::Any), "Any")
  assert_eq(Show::to_string(@clap.Nargs::One), "One")
  assert_eq(Show::to_string(@clap.Nargs::Fixed(7U)), "Fixed(7)")
  assert_eq(Show::to_string(@clap.Nargs::AtLeast(7U)), "AtLeast(7)")
  assert_eq(Show::to_string(@clap.Nargs::AtMost(7U)), "AtMost(7)")
  assert_eq(Show::to_string(@clap.Nargs::Range(7U, 7U)), "Range(7, 7)")
  assert_eq(Show::to_string(@clap.ParserError::InvalidArgumentName("a\"b\nc")), "InvalidArgumentName(a\"b\nc)")
  assert_eq(Show::to_string(@clap.ParserError::InvalidSubCommandName("a\"b\nc")), "InvalidSubCommandName(a\"b\nc)")
  assert_eq(Show::to_string(@clap.ParserError::InvalidPositionalAsNamed("a\"b\nc")), "InvalidPositionalAsNamed(a\"b\nc)")
  assert_eq(Show::to_string(@clap.ParserError::InvalidArgumentValue("a\"b\nc")), "InvalidArgumentValue(a\"b\nc)")
  assert_eq(Show::to_string(@clap.ParserError::InvalidArgumentValueLength("a\"b\nc")), "InvalidArgumentValueLength(a\"b\nc)")
  assert_eq(Show::to_string(@clap.ParserError::TooManyArgs("a\"b\nc")), "TooManyArgs(a\"b\nc)")
  assert_eq(Show::to_string(@clap.ParserError::InvalidSpec("a\"b\nc")), "InvalidSpec(a\"b\nc)")
  assert_eq(Show::to_string(@highlight.Token::{ kind: @highlight.TokenKind::Keyword, text: "a\"b\nc" }), "{kind: Keyword, text: a\"b\nc}")
  assert_eq(Show::to_string(@assets.StaticAsset::{relative_path: "a\"b\nc", bytes: b"ab"}), "{relative_path: a\"b\nc, bytes: b\"ab\"}")
  assert_eq(Show::to_string(value), "{name: a\"b\nc, args: {first: [one, two]}, flags: {verbose: true}, positional_args: [three], subcmd: Some({name: child, args: {}, flags: {}, positional_args: [], subcmd: None})}")
}
